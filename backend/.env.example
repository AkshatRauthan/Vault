# ServerConfig
PORT=3300
NODE_ENV=development

CORS_ORIGIN=*
SERVICE_NAME=backend@vault

LONG_SESSION_EXPIRY=2419000    # 28 days (seconds)
SHORT_SESSION_EXPIRY=86400     # 01 days (seconds)

CSRF_TOKEN_SECRET=csrf-token-secret
SESSION_COOKIE_SECRET=session-cookie-secret

MAX_CONCURRENT_SESSIONS_PER_USER=5


# DbConfig
MONGO_URI=mongodb://localhost:27017/vault


# CacheConfig
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379


# LoggerConfig
MIN_LOG_LEVEL=info