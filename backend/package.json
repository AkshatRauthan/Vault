{
    "name": "vault-backend",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "node dist/src/index.js",
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "dev:env:up": "mkdir -p .docker/redis .docker/redis-insight && docker compose -f docker-compose.dev.yaml up -d --remove-orphans",
        "dev:env:stop": "docker compose -f docker-compose.dev.yaml stop",
        "dev:env:start": "docker compose -f docker-compose.dev.yaml start",
        "dev:env:delete": "docker compose -f docker-compose.dev.yaml down",
        "dev:env:reset": "docker compose -f docker-compose.dev.yaml down && sudo rm -rf .docker/redis .docker/redis-insight",
        "openbao:bootstrap": "tsx scripts/openbao/bootstrap.ts",
        "openbao:certs": "bash scripts/openbao/generate-certs.dev.sh",
        "openbao:certs:windows": "powershell -ExecutionPolicy Bypass -File scripts/openbao/generate-certs.dev.ps1",
        "openbao:permissions": "bash scripts/openbao/fix-permissions.sh",
        "openbao:permissions:windows": "powershell -ExecutionPolicy Bypass -File scripts/openbao/fix-permissions.ps1",
        "openbao:unseal": "  docker exec -it vault-openbao sh -c 'export BAO_ADDR=https://127.0.0.1:8200 BAO_CACERT=/bao/tls/ca.crt; bao operator unseal'"
    },
    "dependencies": {
        "@types/cors": "^2.8.19",
        "argon2": "^0.44.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "16.3.1",
        "express": "^4.22.2",
        "express-rate-limit": "^8.0.0",
        "helmet": "^8.0.0",
        "http-status-codes": "^2.3.0",
        "ioredis": "5.3.2",
        "mongoose": "^8.9.0",
        "ua-parser-js": "^2.0.10",
        "uuidv7": "^1.2.1",
        "winston": "^3.19.0",
        "zod": "3.22.4"
    },
    "devDependencies": {
        "@supabase/supabase-js": "^2.118.0",
        "@types/cookie-parser": "^1.4.8",
        "@types/express": "4.17.21",
        "@types/node": "24.19.2",
        "tsc-alias": "1.8.8",
        "tsx": "^4.19.0",
        "typescript": "5.3.3"
    }
}
