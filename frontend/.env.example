# Backend URL used only by Vite's development proxy.
# Match this to the PORT in your backend .env (backend may use 7001 or 7860).
VITE_BACKEND_URL=http://127.0.0.1:7860

# Leave unset for the same-origin /api development proxy.
# For a deployed same-origin setup, leave unset as well.
# VITE_API_BASE_URL=https://api.example.com/api
