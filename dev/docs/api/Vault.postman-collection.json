{
    "info": {
        "_postman_id": "4900d4c8-ea75-4ed5-a2d7-6eea5be5c182",
        "name": "Vault@local",
        "description": "Vault backend. Select the **Vault@local** environment first. Cookies are handled by Postman's cookie jar; the collection scripts keep `csrfToken`, `userId` and `sessionRef` up to date. Full docs: docs/api/README.md",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Warn early when a state-changing request has no CSRF token.",
                    "// The token is needed on every POST/PATCH/DELETE once a session cookie exists.",
                    "const unsafe = ['POST', 'PUT', 'PATCH', 'DELETE'].indexOf(pm.request.method) !== -1;",
                    "if (unsafe && !pm.environment.get('csrfToken')) {",
                    "    console.warn('csrfToken is empty. Run Register or Login first.');",
                    "}"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Runs after every request: store the CSRF token and user ID from the response.",
                    "// Postman's cookie jar saves the Set-Cookie session cookie and sends it automatically.",
                    "let body = null;",
                    "try { body = pm.response.json(); } catch (e) { body = null; }",
                    "",
                    "if (body && body.csrfToken) {",
                    "    pm.environment.set('csrfToken', body.csrfToken);",
                    "}",
                    "if (body && body.user && body.user.userId) {",
                    "    pm.environment.set('userId', body.user.userId);",
                    "}"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "Health",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
